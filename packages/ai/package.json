{
  "name": "@caucejs/ai",
  "version": "0.9.0",
  "description": "The AI of Cauce: a call to a model and the loop that runs the tools of the application for it, over the HttpClient, with its usage in tokens and typed errors that never carry the prompt.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ldamoredev/caucejs.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/ldamoredev/caucejs/issues"
  },
  "homepage": "https://github.com/ldamoredev/caucejs/tree/main/packages/ai#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manual": "vitest run --config vitest.manual.config.ts"
  },
  "dependencies": {
    "@caucejs/application": "workspace:*",
    "@caucejs/base": "workspace:*",
    "@caucejs/config": "workspace:*",
    "@caucejs/di": "workspace:*",
    "@caucejs/http-client": "workspace:*",
    "@caucejs/tools": "workspace:*"
  },
  "devDependencies": {
    "@caucejs/schema": "workspace:*",
    "@caucejs/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  }
}
