{
  "name": "@caucejs/testing",
  "version": "0.3.0",
  "description": "What Cauce gives a test: examples without randomness, a scenario that builds and saves, and a client that calls an application in memory.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ldamoredev/caucejs.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/ldamoredev/caucejs/issues"
  },
  "homepage": "https://github.com/ldamoredev/caucejs/tree/main/packages/testing#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caucejs/base": "workspace:*",
    "@caucejs/di": "workspace:*"
  },
  "devDependencies": {
    "@caucejs/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
