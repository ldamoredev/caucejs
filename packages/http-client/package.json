{
  "name": "@caucejs/http-client",
  "version": "0.8.0",
  "description": "The HTTP client of Cauce: the fetch standard, injected by the container, with a base, a timeout and typed errors, and replaced in a test without touching globalThis.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ldamoredev/caucejs.git",
    "directory": "packages/http-client"
  },
  "bugs": {
    "url": "https://github.com/ldamoredev/caucejs/issues"
  },
  "homepage": "https://github.com/ldamoredev/caucejs/tree/main/packages/http-client#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@caucejs/base": "workspace:*",
    "@caucejs/di": "workspace:*"
  },
  "devDependencies": {
    "@caucejs/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  }
}
